# ─── Turso / libSQL ────────────────────────────────────────────────
# For production, create a Turso DB:  turso db create aeo-monitor
#   then:  turso db show aeo-monitor --url   /  turso db tokens create aeo-monitor
# For local dev you can point at a file instead:  TURSO_DATABASE_URL=file:local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── AI engine API keys ────────────────────────────────────────────
# Anthropic powers BOTH the Claude monitoring engine AND the response parser.
# This is the only strictly-required key; engines without a key are skipped.
ANTHROPIC_API_KEY=

OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# ─── Model overrides (optional) ────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-6
PARSER_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash
PERPLEXITY_MODEL=sonar

# ─── Cron / security ───────────────────────────────────────────────
# Vercel sends this as a Bearer token on cron requests. Set the same value
# in Vercel project settings so the cron routes can authenticate callers.
CRON_SECRET=

# ─── Alerts (Mandrill / Mailchimp Transactional) ───────────────────
MANDRILL_API_KEY=
ALERT_EMAIL_TO=willhstewart2@gmail.com
ALERT_EMAIL_FROM=info@empower-core.com
# Drop in visibility score (points) that triggers an alert email.
ALERT_DROP_THRESHOLD=10
